# Optional: point the gateway at a different YAML policy file.
AGENT_GATEWAY_POLICY=policies/default.yaml
AGENT_GATEWAY_UPSTREAM=http://127.0.0.1:9001

# Optional: Groq API credentials for the "Test Projects" multi-agent suite (port 8010).
# Copy this file to .env and paste your Groq key, or paste it in the UI at http://127.0.0.1:8010
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_GATEWAY_HOST=http://127.0.0.1:8000
